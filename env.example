# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Every variable the app reads is listed here —
# api/config.py checks each required one at startup and refuses to start
# with a clear error naming exactly which one is missing, instead of
# falling back to a value that only made sense on a developer's laptop.

# ============================================================
# Required
# ============================================================

# Postgres password (docker-compose.yml builds DATABASE_URL from this —
# you don't need to set DATABASE_URL yourself when using docker-compose).
POSTGRES_PASSWORD=

# Random secret used to sign login sessions (JWTs). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must NOT be left as a placeholder — the app checks for and rejects
# known placeholder values on startup.
JWT_SECRET=

# ============================================================
# Optional — auth behavior
# ============================================================

# How long a login session lasts, in minutes. Default: 480 (8 hours).
JWT_EXPIRES_MINUTES=480

# Whether new users can create their own account via POST /auth/signup.
# The very first account created on a fresh database always becomes
# admin, regardless of this setting, so there's always a real path to a
# first login. Set to "false" to require an admin to create accounts
# some other way (e.g. directly in the DB) after that first account exists.
ALLOW_SELF_SIGNUP=true

# ============================================================
# Optional — report storage
# ============================================================

# "local" (default) stores generated PPTX/PDF/XLSX reports on a Docker
# volume inside the app container — no external account needed to run
# the platform end to end. Set to "s3" to use real object storage
# (AWS S3, Cloudflare R2, MinIO, ...) instead, e.g. for a cloud deploy
# where a persistent local volume isn't desirable.
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=local. Path inside the container;
# docker-compose.yml already mounts a volume here, don't change unless
# you also update the volume mount.
LOCAL_STORAGE_DIR=/data/reports

# Only used when STORAGE_BACKEND=s3 (all four are required in that case):
# S3_BUCKET=
# S3_ENDPOINT=            # leave blank for real AWS S3; set for R2/MinIO
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# ============================================================
# Optional — Microsoft OneDrive/SharePoint connectivity
# ============================================================
# All three ingestion paths are independent; you don't need any of these
# to use manual upload or the direct share-link sync. Leave blank to
# disable the two Graph-API-based paths — the app will fail those
# specific requests clearly rather than crash on startup.

# Azure AD app registration, used by BOTH Graph-API paths below.
MS_TENANT_ID=
MS_CLIENT_ID=

# Required only for the app-only connector (background sync of an entire
# folder; needs a client secret because it authenticates as itself, with
# no signed-in user, via Files.Read.All / Sites.Read.All application
# permission granted by a tenant admin).
MS_CLIENT_SECRET=

# Required only for delegated OAuth ("Connect your Microsoft account" —
# the signed-in user consents for themselves; no tenant admin required
# unless the org has blocked user consent). Must exactly match the
# redirect URI configured on the Azure AD app registration.
MS_OAUTH_REDIRECT_URI=http://localhost:8000/ms-oauth/callback

# ============================================================
# Optional — networking
# ============================================================

# Comma-separated list of origins allowed to call this API. Since the
# frontend is served from the same container/origin as the API in the
# default docker-compose setup, http://localhost:8000 covers local use;
# add your real domain(s) for a cloud deploy.
CORS_ORIGINS=http://localhost:8000

# ============================================================
# Set automatically by docker-compose.yml — do not set manually
# ============================================================
# DATABASE_URL   (built from POSTGRES_PASSWORD above)
# REDIS_URL      (points at the redis service in docker-compose.yml)
